   "source": [
    "import numpy as np\n",
    "\n",
    "n=100000\n",
    "T=1\n",
    "dt=T/n\n",
    "m=1\n",
    "\n",
    "rng = np.random.default_rng(42)\n",
    "\n",
    "Z = rng.standard_normal((n))\n",
    "dW = Z*np.sqrt(dt)\n",
    "W = np.cumsum(dW,axis=0)\n",
    "A=np.zeros(1)\n",
    "W_t = np.concatenate((A,W))\n",
    "\n",
    "S = np.sum(2*W_t[:-1]*dW)\n",
    "\n",
    "print(S)\n",
    "print(W_t[-1]**2-S)"
   ]
  },
